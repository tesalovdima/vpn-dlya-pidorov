# ============================================================================
#  Правила переводов строк. ВАЖНО:
#  - в репозитории всё хранится в LF;
#  - при скачивании архива (zip с GitHub) и при checkout файлы получают
#    правильные для своей платформы переводы строк.
#
#  Без этого .bat из архива приходит с LF, а cmd такие файлы ломает:
#  строки разваливаются и он пытается выполнять куски текста как команды
#  ("'remove' is not recognized as an internal or external command").
# ============================================================================
* text=auto

# Windows: cmd и PowerShell требуют CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf

# Серверный bash: строго LF (CRLF ломает shebang и сами скрипты)
*.sh    text eol=lf
*.bash  text eol=lf
